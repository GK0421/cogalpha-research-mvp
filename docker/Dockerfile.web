# docker/Dockerfile.web
# CogAlpha Studio - Frontend Web Image
# Multi-stage build: Node build -> Nginx serve

# --- Stage 1: Build frontend ---
FROM node:20-slim AS builder

WORKDIR /app

# Copy package files
COPY apps/web/package.json apps/web/package-lock.json* ./

# Install dependencies
RUN npm install --silent

# Copy source (exclude test files via .dockerignore patterns)
COPY apps/web/ ./

# Set API URL for production build
ENV VITE_API_BASE_URL=http://127.0.0.1:8765/api

# Build (skip tests, only build production bundle)
RUN npx vite build

# --- Stage 2: Serve with Nginx ---
FROM nginx:alpine

LABEL org.opencontainers.image.title="CogAlpha Studio Web"
LABEL org.opencontainers.image.version="0.2.1"

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx config
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
