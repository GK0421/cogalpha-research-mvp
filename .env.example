# CogAlpha Research MVP - Environment Variables
# Copy this file to .env and fill in your API keys.
# NEVER commit the real .env file to version control.

# LLM API Keys (ALL OPTIONAL)
# The MVP works fully with 21 built-in seed factors and requires NO API key.
# Set a key below only if you want to enable LLM-based factor generation.
# The pipeline degrades gracefully: if no key is set, it uses seed factors only.

# iFlytek Spark (讯飞星辰 Coding Plan) - OpenAI-compatible
# Docs: https://www.xfyun.cn/doc/spark/CodingPlan.html
# Models: astron-code-latest (auto-routes to Spark X2, GLM-5.2, DeepSeek-V4, etc.)
IFLYTEK_SPARK_API_KEY=
IFLYTEK_SPARK_BASE_URL=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
IFLYTEK_SPARK_MODEL=astron-code-latest

# MiniMax (recommended for Chinese market research)
MINIMAX_API_KEY=

# OpenAI-compatible endpoints (set BASE_URL if using a proxy)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# Alibaba DashScope (Qwen)
DASHSCOPE_API_KEY=
